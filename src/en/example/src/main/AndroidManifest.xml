<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-sdk
        android:minSdkVersion="21"
        android:targetSdkVersion="34" />

    <!-- Required per https://github.com/mihonapp/tachiyomix#-extension-manifest-requirements -->
    <uses-feature android:name="tachiyomi.extension" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="${appName}"
        android:roundIcon="@android:drawable/sym_def_app_icon"
        android:supportsRtl="true">

        <!-- The display name of the extension -->
        <meta-data
            android:name="tachiyomix.name"
            android:value="${appName}" />
        <!-- Content Rating: 0 = Safe, 1 = Mixed, 2 = NSFW -->
        <meta-data
            android:name="tachiyomix.contentWarning"
            android:value="${nsfw}" />
        <!-- Target library version -->
        <meta-data
            android:name="tachiyomix.extensionLib"
            android:value="${libVersion}" />
        <!-- The extension's entry point class -->
        <meta-data
            android:name="tachiyomi.extension.class"
            android:value="${extClass}" />
    </application>

</manifest>
